    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.2",
    "jsdom": "^25.0.1",
    "sharp": "^0.33.5",
    "vite": "^5.4.8",
    "vitest": "^2.1.2"
  }
}
