{
  "name": "portfolio-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Patrik Cesnek — senior iOS developer portfolio",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/entry-server.jsx --outDir dist/server && node scripts/prerender.mjs",
